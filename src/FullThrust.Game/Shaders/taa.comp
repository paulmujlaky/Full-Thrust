#version 450

#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 1, binding = 0) uniform sampler2D sceneColor;
layout(set = 1, binding = 1) uniform sampler2D sceneVelocity;
layout(set = 1, binding = 2) uniform sampler2D sceneDepth;
layout(set = 1, binding = 3) uniform sampler2D history;
layout(set = 1, binding = 4, rgba16f) uniform writeonly image2D resolved;

layout(push_constant) uniform Push {

    // x: weight of the new frame, 1 passes it through; y: how far history may stray from this frame's neighbourhood, in standard deviations.
    vec4 params;

} pc;

vec3 ToYCoCg(vec3 c) {

    return vec3(0.25 * c.r + 0.5 * c.g + 0.25 * c.b, 0.5 * c.r - 0.5 * c.b, -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);

}

vec3 FromYCoCg(vec3 c) {

    return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z);

}

// Compresses highlights so one bright sample cannot outweigh its neighbours; inverted after blending.
vec3 Compress(vec3 c) {

    return c / (1.0 + max(c.r, max(c.g, c.b)));

}

vec3 Expand(vec3 c) {

    return c / max(1.0 - max(c.r, max(c.g, c.b)), 1e-4);

}

// Catmull-Rom in five bilinear taps: bilinear history blurs a little more every frame it is resampled.
vec3 SampleHistory(vec2 uv) {

    vec2 size = vec2(textureSize(history, 0));
    vec2 position = uv * size;
    vec2 center = floor(position - 0.5) + 0.5;
    vec2 f = position - center;

    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2;

    vec2 t0 = (center - 1.0) / size;
    vec2 t3 = (center + 2.0) / size;
    vec2 t12 = (center + w2 / w12) / size;

    vec3 sum = textureLod(history, vec2(t12.x, t0.y), 0.0).rgb * (w12.x * w0.y)
        + textureLod(history, vec2(t0.x, t12.y), 0.0).rgb * (w0.x * w12.y)
        + textureLod(history, vec2(t12.x, t12.y), 0.0).rgb * (w12.x * w12.y)
        + textureLod(history, vec2(t3.x, t12.y), 0.0).rgb * (w3.x * w12.y)
        + textureLod(history, vec2(t12.x, t3.y), 0.0).rgb * (w12.x * w3.y);

    float weight = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;

    return max(sum / weight, vec3(0.0));

}

void main() {

    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(resolved);

    if (any(greaterThanEqual(pixel, size))) {

        return;

    }

    vec3 now = texelFetch(sceneColor, pixel, 0).rgb;

    if (pc.params.x >= 1.0) {

        imageStore(resolved, pixel, vec4(now, 1.0));

        return;

    }

    // Neighbourhood statistics, and the nearest surface in it: its motion keeps thin edges from trailing their background's.
    vec3 sum = vec3(0.0);
    vec3 squares = vec3(0.0);
    float nearest = 0.0;
    ivec2 nearestPixel = pixel;

    for (int y = -1; y <= 1; y++) {

        for (int x = -1; x <= 1; x++) {

            ivec2 tap = clamp(pixel + ivec2(x, y), ivec2(0), size - 1);
            vec3 c = ToYCoCg(Compress(texelFetch(sceneColor, tap, 0).rgb));

            sum += c;
            squares += c * c;

            float depth = texelFetch(sceneDepth, tap, 0).r;

            if (depth > nearest) {

                nearest = depth;
                nearestPixel = tap;

            }

        }

    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec2 velocity;

    if (nearest > 0.0) {

        velocity = texelFetch(sceneVelocity, nearestPixel, 0).rg;

    } else {

        // Sky: nothing wrote velocity, and at infinity only the camera's turning moves it.
        vec2 ndc = uv * 2.0 - 1.0;
        vec4 before = frame.previousViewProjection * vec4(ViewDirection(ndc + frame.jitter.xy), 0.0);

        velocity = before.w > 0.0 ? (ndc - before.xy / before.w) * 0.5 : vec2(2.0);

    }

    vec2 historyUv = uv - velocity;

    if (any(lessThan(historyUv, vec2(0.0))) || any(greaterThan(historyUv, vec2(1.0)))) {

        imageStore(resolved, pixel, vec4(now, 1.0));

        return;

    }

    vec3 mean = sum / 9.0;
    vec3 spread = sqrt(max(squares / 9.0 - mean * mean, vec3(0.0)));
    vec3 previous = ToYCoCg(Compress(SampleHistory(historyUv)));

    // Clip towards the mean rather than clamp per channel, which would shift the hue of rejected history.
    vec3 offset = previous - mean;
    vec3 limit = spread * pc.params.y + 1e-5;
    vec3 ratio = abs(offset) / limit;
    float excess = max(ratio.x, max(ratio.y, ratio.z));

    if (excess > 1.0) {

        previous = mean + offset / excess;

    }

    vec3 current = ToYCoCg(Compress(now));

    // Fast motion resamples history between texels each frame, so it is trusted a little less.
    float weight = mix(pc.params.x, 0.25, clamp(length(velocity * vec2(size)) / 40.0, 0.0, 1.0));

    imageStore(resolved, pixel, vec4(Expand(max(FromYCoCg(mix(previous, current, weight)), vec3(0.0))), 1.0));

}
