#version 450

#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 1, binding = 0) uniform sampler2D current;
layout(set = 1, binding = 1) uniform sampler2D distances;
layout(set = 1, binding = 2) uniform sampler2D history;
layout(set = 1, binding = 3, rgba16f) uniform writeonly image2D resolved;

layout(push_constant) uniform Push {

    mat4 previousViewProjection;

    // xyz: this frame's floating origin minus the previous one; w: weight of the new frame.
    vec4 originShift;

    // xyz: with craftTurn, maps a point moving with the craft back to last frame; w: terrain slot of the body whose ground and air the other volumes turn with, or -1.
    vec4 motion;

    // Which pixel of each 2x2 block was marched: xy this frame, zw last frame.
    vec4 offsets;

    // Inverse of the craft's rotation since last frame, applied about the render-local origin.
    vec4 craftTurn;

} pc;

// Temporal accumulation: history reprojected through where the volume was seen, clamped to this frame's neighbourhood.
void main() {

    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(resolved);

    if (any(greaterThanEqual(pixel, size))) {

        return;

    }

    vec4 now = texelFetch(current, pixel, 0);

    if (pc.originShift.w >= 1.0) {

        imageStore(resolved, pixel, now);

        return;

    }

    vec4 sum = vec4(0.0);
    vec4 squares = vec4(0.0);

    for (int y = -1; y <= 1; y++) {

        for (int x = -1; x <= 1; x++) {

            vec4 neighbour = texelFetch(current, clamp(pixel + ivec2(x, y), ivec2(0), size - 1), 0);

            sum += neighbour;
            squares += neighbour * neighbour;

        }

    }

    // Clip history to the neighbourhood's spread rather than its extremes: a jittered march is noisy enough that min-max lets moving history smear.
    vec4 mean = sum / 9.0;
    vec4 spread = sqrt(max(squares / 9.0 - mean * mean, vec4(0.0)));
    vec4 low = mean - spread * 1.25;
    vec4 high = mean + spread * 1.25;

    ivec2 full = min(pixel * 2 + ivec2(pc.offsets.xy), ivec2(frame.viewport.xy) - 1);
    vec2 ndc = (vec2(full) + 0.5) * frame.viewport.zw * 2.0 - 1.0;
    float signedDistance = texelFetch(distances, pixel, 0).r;
    float distance = min(abs(signedDistance), 1e7);
    vec3 position = frame.cameraPosition.xyz + ViewDirection(ndc) * distance;

    // Where this bit of volume was last frame, in last frame's render-local space.
    if (signedDistance < 0.0) {

        position = QuaternionRotate(pc.craftTurn, position) + pc.motion.xyz;

    } else if (pc.motion.w >= 0.0) {

        position = PreviousTerrainPosition(int(pc.motion.w), position);

    } else {

        position += pc.originShift.xyz;

    }

    vec4 clip = pc.previousViewProjection * vec4(position, 1.0);
    vec2 uv = clip.xy / clip.w * 0.5 + 0.5;

    float weight = pc.originShift.w;

    // Exhaust and plasma reshape as the craft turns; while it turns a short memory keeps them from trailing behind.
    if (signedDistance < 0.0) {

        float turned = 2.0 * asin(min(length(pc.craftTurn.xyz), 1.0));

        weight = max(weight, mix(weight, 0.35, smoothstep(0.0005, 0.006, turned)));

    }

    // History fetched from far away is stale under fast camera motion, so the further a pixel travelled the more this frame counts.
    vec2 travel = (uv - (vec2(full) + 0.5) * frame.viewport.zw) * vec2(size);

    weight = max(weight, mix(weight, 0.6, smoothstep(0.5, 6.0, length(travel))));

    if (clip.w <= 0.0 || any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) {

        imageStore(resolved, pixel, now);

        return;

    }

    // History texel centres sit on whichever pixel of each 2x2 block was marched last frame, not the block centre.
    vec2 historyUv = (uv * frame.viewport.xy - pc.offsets.zw + 0.5) / (2.0 * vec2(size));
    vec4 previous = clamp(texture(history, historyUv), low, high);
    float change = abs(previous.a - now.a);
    weight = max(weight, smoothstep(0.05, 0.3, change) * 0.8);

    imageStore(resolved, pixel, mix(previous, now, weight));

}
