#version 450

#include "common.glsl"
#include "volumetric.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 1, binding = 7, r16f) uniform writeonly image2D cloudShadowTarget;

// The first eight fields of VolumePrimitive; push constants stop at 128 bytes.
layout(push_constant) uniform Push {

    ivec4 kind;
    vec4 position;
    vec4 axis;
    vec4 medium;
    vec4 emission;
    vec4 params0;
    vec4 params1;
    vec4 params2;

} pc;

const int Steps = 24;

// A grazing sun crosses hundreds of kilometres of layer; past this the light is gone anyway.
const float MaxCrossing = 20000.0;

// Each texel marches its line of sunlight through the layer on the sun side of its base and stores the transmittance.
void main() {

    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(cloudShadowTarget);

    if (any(greaterThanEqual(texel, size))) {

        return;

    }

    VolumePrimitive layer = VolumePrimitive(pc.kind, pc.position, pc.axis, pc.medium, pc.emission, pc.params0, pc.params1, pc.params2, vec4(0.0), ivec4(0));

    vec3 u;
    vec3 v;
    vec3 center = CloudShadowCenter(u, v);
    vec2 s = (vec2(texel) + 0.5) / vec2(size) * 2.0 - 1.0;
    vec2 offset = CloudShadowUnwarp(s) * (0.5 * CloudShadowExtent);

    // Width of this texel on the ground: the warp makes it a tenth of the average under the camera.
    float texelSize = CloudShadowExtent / float(size.x) * (CloudShadowWarp + 2.0 * (1.0 - CloudShadowWarp) * max(abs(s.x), abs(s.y)));

    vec3 sun = frame.sunDirection.xyz;
    vec3 line = center + u * offset.x + v * offset.y - layer.params0.xyz;

    float outerNear;
    float outerFar;
    float innerNear;
    float innerFar;

    if (!RaySphere(line, sun, layer.params1.x, outerNear, outerFar)) {

        imageStore(cloudShadowTarget, texel, vec4(1.0));

        return;

    }

    float start = RaySphere(line, sun, layer.params0.w, innerNear, innerFar) ? innerFar : outerNear;
    float end = min(outerFar, start + MaxCrossing);
    float dt = (end - start) / float(Steps);
    float depth = 0.0;

    // Wisps finer than a texel or a step alias differently each time the map moves under the camera, which shimmers on the ground.
    volumeFootprint = max(3.0 * texelSize, dt);

    for (int i = 0; i < Steps; i++) {

        vec3 p = layer.params0.xyz + line + sun * (start + (float(i) + 0.5) * dt);

        depth += CloudLayer(layer, p).extinction * dt;

    }

    imageStore(cloudShadowTarget, texel, vec4(exp(-depth)));

}
